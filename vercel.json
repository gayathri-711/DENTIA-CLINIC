{
  "version": 2,
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js?_route=$1"
    },
    {
      "source": "/booking.php",
      "destination": "/api/index.js?_route=book-appointment.php"
    },
    {
      "source": "/contact.php",
      "destination": "/api/index.js?_route=contact.php"
    },
    {
      "source": "/admin",
      "destination": "/admin/index.html"
    },
    {
      "source": "/admin/",
      "destination": "/admin/index.html"
    },
    {
      "source": "/services",
      "destination": "/services.html"
    },
    {
      "source": "/services/",
      "destination": "/services.html"
    },
    {
      "source": "/booking",
      "destination": "/booking.html"
    },
    {
      "source": "/login",
      "destination": "/login.html"
    },
    {
      "source": "/register",
      "destination": "/register.html"
    },
    {
      "source": "/doctor-login",
      "destination": "/doctor-login.html"
    },
    {
      "source": "/doctor-dashboard",
      "destination": "/doctor-dashboard.html"
    },
    {
      "source": "/patient-dashboard",
      "destination": "/patient-dashboard.html"
    },
    {
      "source": "/dashboard",
      "destination": "/patient-dashboard.html"
    }
  ]
}